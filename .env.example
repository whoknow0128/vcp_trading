# 永豐 Shioaji API 憑證設定（支援官方 SJ_* 與別名 SHIOAJI_*）
# 請複製此檔為 .env 並填入你的金鑰（.env 已加入 .gitignore，請勿提交至 Git）
SJ_API_KEY=
SJ_SEC_KEY=

# false = 模擬環境（預設）；true = 正式行情環境（純看盤／快照不需 CA 憑證）
SJ_PRODUCTION=false

# 以下兩項僅於「正式環境實際下單」時才需要，純即時報價與預估量監控可留空
SJ_CA_PATH=
SJ_CA_PASSWD=

# Telegram 通知設定（支援 TG_* 與別名 VITE_TG_*）
TG_BOT_TOKEN=
TG_CHAT_ID=
